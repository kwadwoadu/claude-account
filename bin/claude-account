#!/usr/bin/env bash
# claude-account: keep several Claude Code subscription logins side by side and
# switch the active one. Works with any number of accounts.
#
# Claude Code on Linux stores its login as one plaintext OAuth file that refreshes
# its own token. There is no built-in multi-account support, so this tool keeps
# named COPIES of that file ("slots") and swaps which copy is live.
#
# Slots:        ~/.claude-accounts/<Name>.json
# Live login:   ~/.claude/.credentials.json
# Active slot:  ~/.claude-accounts/active   (name of the slot that is live)
# Backups:      ~/.claude-accounts/backups/live-*.json (the live login before each
#               switch) and backups/slots/<Name>/ (a slot's own login before a
#               fresh /login was copied over it); the newest 10 of each are kept.
# Locks:        ~/.claude-accounts/switch.lock (one switch or save at a time) and
#               usage.lock (the usage cache); wait CLAUDE_ACCOUNT_LOCK_WAIT seconds.
# Marks:        ~/.claude-accounts/capped/<Name> and unusable/<Name>, empty files
#               any script may touch; status shows them and how long each holds.
#
# Conversations are NOT in the credentials file. They live in
# ~/.claude/projects/<cwd>/*.jsonl, so switching accounts leaves them in place.
#
# After any manual /login, run: claude-account save <Name>   so the slot matches.
set -euo pipefail

VERSION="1.1.0"

DIR="${CLAUDE_ACCOUNTS_DIR:-$HOME/.claude-accounts}"
LIVE="${CLAUDE_CREDENTIALS:-$HOME/.claude/.credentials.json}"
CLAUDE_JSON="${CLAUDE_JSON:-$HOME/.claude.json}"
ACTIVE_FILE="$DIR/active"
CAPPED_DIR="$DIR/capped"
UNUSABLE_DIR="$DIR/unusable"
PIN_FILE="$DIR/pinned"
BACKUP_DIR="$DIR/backups"
BACKUP_KEEP=10
# How much of each subscription is left. One line per slot, pipe separated:
#   <slot>|<5h percent>|<5h reset epoch>|<7d percent>|<7d reset epoch>|<fetched epoch>
# Plain text, not JSON, so a statusline can read it on every render without
# parsing JSON or touching the network.
USAGE_CACHE="$DIR/usage.cache"
USAGE_TTL=900      # 15 min: older than this and status/statusline say nothing
USAGE_URL="https://api.anthropic.com/api/oauth/usage"
# How long a mark holds a slot: 30 minutes after a cap mark, 6 hours after an
# unusable mark. status --json turns them into held_until, so a reader (the
# account-picker mod, a rotation script) keeps no copy of its own.
CAP_TTL=1800
UNUSABLE_TTL=21600
LOCK_WAIT=${CLAUDE_ACCOUNT_LOCK_WAIT:-30}

umask 077
# The folder holds plaintext logins: a new one is made mode 700, and an existing one
# that we own is tightened to 700 on every run (a folder made by hand or copied in
# with mode 755 would otherwise leave the slot files readable to others).
if [[ ! -d $DIR ]]; then mkdir -p "$DIR"; chmod 700 "$DIR"; elif [[ -O $DIR ]]; then chmod 700 "$DIR"; fi

helptext() {
  cat <<'EOF'
claude-account - run several Claude Code subscription logins side by side.

usage: claude-account <command> [args]

commands:
  status | list [--json]
                      show the active slot, saved slots, usage and marks;
                      --json prints the same as raw percents used and epochs
  whoami | who        which slot and account the live login really is
  save <Name>         store the current live login in a named slot (marks it active)
  switch|use <Name> [--from <Live>]
                      make that slot the live login. The live token is first
                      copied back to its own slot, and the live file is backed
                      up. Running sessions pick up the new login before their
                      next request, with no restart. A pin follows the switch.
                      --from (for scripts): switch only while <Live> is still
                      live and nothing is pinned; else exit 3, nothing changed.
  next | swap         switch to the next slot in rotation
  usage [--slot <Name>] [--quiet]
                      how much of each subscription is left (5-hour and weekly
                      windows), read per slot WITHOUT switching into it.
                      Refreshes the cache that status reads.
  pin                 set a hold flag on the current account, for your own
                      auto-rotation scripts (~/.claude-accounts/pinned)
  unpin               clear the hold flag
  history [N]         the last N switches, pins and unpins (default 20): time
                      (UTC), what changed, and who asked (CLAUDE_ACCOUNT_CALLER,
                      else the calling program)
  --help  | -h        show this help
  --version | -v      show version

Slots live in ~/.claude-accounts (override: CLAUDE_ACCOUNTS_DIR); the live login
is ~/.claude/.credentials.json (override: CLAUDE_CREDENTIALS). After any manual
/login, run `claude-account save <Name>` so the slot matches the new login.
EOF
}
usage() { helptext >&2; exit 1; }

# "unknown" is what active() prints when no slot is live, so it can never name one.
valid_name() { [[ $1 =~ ^[A-Za-z0-9_-]+$ && $1 != active && $1 != capped && $1 != backups && $1 != unknown && $1 != unusable ]]; }
# The active file is plain text anyone with access to $DIR can edit, so its value
# is checked like a slot name before it is used to build a path.
active() {
  local a; a=$(cat "$ACTIVE_FILE" 2>/dev/null || true)
  if [[ -n $a ]] && valid_name "$a"; then echo "$a"; else echo "unknown"; fi
}

# Copy $1 over $2 in one step: a temp file in the same folder, mode 600, then mv.
# A running Claude Code session reads the live file before each token use, so a
# plain cp, which empties the file and then writes it, can hand it an empty login.
put_file() {      # $1 = source  $2 = destination
  local tmp; tmp=$(mktemp "$(dirname "$2")/.claude-account.XXXXXX")
  cp "$1" "$tmp"; chmod 600 "$tmp"; mv -f "$tmp" "$2"
}

file_epoch() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"; }
fmt_epoch() {     # $1 = epoch  $2 = date format
  date -d "@$1" "$2" 2>/dev/null || date -r "$1" "$2" 2>/dev/null || true
}

json_field() {    # $1 = file  $2 = key inside claudeAiOauth -> value, or empty
  python3 - "$1" "$2" <<'EOF' 2>/dev/null || true
import json,sys
try:
    v=json.load(open(sys.argv[1]))["claudeAiOauth"].get(sys.argv[2])
    print(v if isinstance(v,str) else "")
except Exception:
    pass
EOF
}

# A slot is a COPY of the Claude credentials file, which always carries a
# "claudeAiOauth" object. Any OTHER .json in this folder (a stray backup, an
# editor file) must never be treated as a slot: `next` would rotate into it and
# `switch` would copy it over the live login, which logs you out. A rotation
# script that runs on its own would do that with no one watching.
looks_like_credentials() { grep -q 'claudeAiOauth' "$1" 2>/dev/null; }
slots() {
  local f n
  for f in "$DIR"/*.json; do
    [[ -e $f ]] || continue
    n=$(basename "$f" .json)
    valid_name "$n" && looks_like_credentials "$f" && echo "$n"
  done | sort
}

# The live file refreshes its own OAuth token, so before it is swapped out, it is
# copied back into its slot, or the saved copy goes stale. A failed refresh can
# blank the token; copying THAT back would destroy a good slot, so a live file
# without both tokens is never copied back.
sync_back() {
  local cur; cur=$(active)
  [[ -f $LIVE && $cur != unknown && -f $DIR/$cur.json ]] || return 0
  if [[ -z $(json_field "$LIVE" accessToken) || -z $(json_field "$LIVE" refreshToken) ]]; then
    echo "warning: the live login has an empty token; slot $cur keeps its saved copy" >&2
    return 0
  fi
  # Known drift: the live token is exactly another slot's saved token, so the live
  # login is that slot's account. Copying it back would give $cur that account.
  # One python run for every slot, as this runs under the switch lock.
  local owner others; mapfile -t others < <(slots)
  owner=$(python3 - "$LIVE" "$DIR" "$cur" "${others[@]}" <<'EOF' 2>/dev/null || true
import json,sys
def tok(path):
    try: return json.load(open(path))["claudeAiOauth"].get("accessToken") or ""
    except Exception: return ""
live,folder,cur=tok(sys.argv[1]),sys.argv[2],sys.argv[3]
for s in sys.argv[4:]:
    if s!=cur and live and tok("%s/%s.json" % (folder,s))==live:
        print(s); break
EOF
)
  if [[ -n $owner ]]; then
    echo "warning: the live login is slot $owner's, not $cur's; slot $cur keeps its saved copy" >&2
    return 0
  fi
  # Unknown drift: a fresh /login matches no slot, and nothing in the file tells
  # which account it is. Keep the slot's own copy first, so neither login is lost.
  cmp -s "$LIVE" "$DIR/$cur.json" || backup_slot "$cur"
  put_file "$LIVE" "$DIR/$cur.json"
}

# Keep a copy of the live login before it is overwritten. This covers a login
# that was never saved and a live login that drifted to another account after a
# manual /login. Without it, `switch` would lose that login for good.
backup_live() {
  [[ -f $LIVE ]] || return 0
  mkdir -p "$BACKUP_DIR"
  put_file "$LIVE" "$BACKUP_DIR/live-$(date +%Y%m%d-%H%M%S)-$$.json"
  prune_backups "$BACKUP_DIR" 'live-*.json'
}

# Keep a slot's saved login before sync_back overwrites it. Each slot has a folder
# of its own, so pruning one slot can never reach another, whatever the names.
backup_slot() {   # $1 = slot
  local d="$BACKUP_DIR/slots/$1"
  mkdir -p "$d"
  put_file "$DIR/$1.json" "$d/$(date +%Y%m%d-%H%M%S)-$$.json"
  prune_backups "$d" '*.json'
}

prune_backups() { # $1 = folder  $2 = name pattern -> keep the newest BACKUP_KEEP
  local old
  old=$(find "$1" -maxdepth 1 -name "$2" | sort | head -n -"$BACKUP_KEEP" 2>/dev/null || true)
  [[ -z $old ]] || echo "$old" | while IFS= read -r f; do rm -f "$f"; done
}

# One line per switch, pin and unpin in $DIR/switch.log, so a switch nobody
# remembers can be traced. Callers name themselves in CLAUDE_ACCOUNT_CALLER (the
# account-picker mod says account-picker); a person at a shell shows as the
# calling program. Only the program name is logged, never its arguments.
SWITCH_LOG="$DIR/switch.log"
log_switch() {   # $1 = what changed
  local by=${CLAUDE_ACCOUNT_CALLER:-$(ps -o comm= -p "$PPID" 2>/dev/null)}
  # Some ps builds print a path, and a login shell's name starts with "-" (-zsh).
  # Keep one plain word, so a caller can never add a line or break the format.
  by=${by##*/}; by=${by#-}; by=${by//[^A-Za-z0-9._-]/_}
  printf '%s %s by=%s\n' "$(date -u +%FT%TZ)" "$1" "${by:-unknown}" >> "$SWITCH_LOG"
  if (( $(wc -l < "$SWITCH_LOG") > 1000 )); then
    tail -n 500 "$SWITCH_LOG" > "$SWITCH_LOG.tmp" && mv "$SWITCH_LOG.tmp" "$SWITCH_LOG"
  fi
}

# One switch or save at a time, across processes (the account-picker mod in any
# session, a shell, a script): two at once each copy the live login back to a
# slot, so one slot can end up holding the other account's login.
# A machine without flock runs unlocked. fd 8 holds the switch lock, fd 7 the
# usage cache lock.
have_flock() { command -v flock >/dev/null 2>&1; }
take_switch_lock() {
  have_flock || return 0
  exec 8>"$DIR/switch.lock"
  flock -w "$LOCK_WAIT" 8 || { echo "another claude-account switch or save is still running; nothing changed" >&2; exit 1; }
}

# The endpoint that Claude Code itself calls (api/oauth/usage). It answers for the
# account the bearer token belongs to, so every slot can be read WITHOUT switching
# into it. Switching into a slot just to read it is the risky path: a failed
# refresh blanks the live token. The token goes in on stdin, never as an argument:
# arguments are visible to every local user in the process list. curl gets the
# header on stdin too (-H @-).
# Tests set USAGE_FETCH_CMD; it gets the token on stdin and nothing reaches the network.
fetch_usage() {   # stdin = access token -> response body on stdout
  if [[ -n ${USAGE_FETCH_CMD:-} ]]; then "$USAGE_FETCH_CMD"; return $?; fi
  local tok; IFS= read -r tok
  printf 'Authorization: Bearer %s\n' "$tok" | curl -sS --max-time 15 \
    -H @- \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "User-Agent: claude-account/$VERSION" \
    "$USAGE_URL"
}

# An access token lives a few hours; a refresh token lives weeks. Only a Claude Code
# session refreshes the pair, so a SAVED slot often carries an expired access token
# and the endpoint answers 401 for it. The live login has the fresh token, so the
# active slot is read from there. This tool never refreshes a token itself: that
# rotates the refresh token and logs out any other machine that uses the same copy.
token_of() {      # $1 = slot name -> access token, or empty
  local src="$DIR/$1.json"
  [[ $1 == "$(active)" && -f $LIVE ]] && src="$LIVE"
  json_field "$src" accessToken
}

# Response file -> "<5h pct>|<5h reset epoch>|<7d pct>|<7d reset epoch>", or empty on
# anything unexpected. utilization is a percent USED, so remaining is 100 minus it.
# The body comes in as a FILE PATH: the heredoc already owns stdin, so python would
# take a body sent on stdin as its own program.
parse_usage() {   # $1 = file holding the response body
  python3 - "$1" <<'EOF' 2>/dev/null || true
import json,sys,datetime
def ep(v):
    if not v: return ""
    try: return str(int(datetime.datetime.fromisoformat(v).timestamp()))
    except Exception: return ""
try:
    d=json.load(open(sys.argv[1]))
    a=d.get("five_hour") or {}
    b=d.get("seven_day") or {}
    u1,u2=a.get("utilization"),b.get("utilization")
    if u1 is None and u2 is None: sys.exit(1)
    print("%s|%s|%s|%s" % (
        "" if u1 is None else int(round(u1)), ep(a.get("resets_at")),
        "" if u2 is None else int(round(u2)), ep(b.get("resets_at"))))
except Exception:
    sys.exit(1)
EOF
}

# Read, change and replace under one lock: two `usage` runs at once (the picker in
# two sessions, a statusline refresh) would each drop the line the other wrote.
cache_put() {     # $1=slot  $2="p5|r5|p7|r7"
  if have_flock; then
    exec 7>"$DIR/usage.lock"
    if ! flock -w "$LOCK_WAIT" 7; then
      exec 7>&-
      echo "usage cache is locked by another run; slot $1 not cached" >&2
      return 0
    fi
  fi
  local tmp; tmp=$(mktemp "$DIR/.usage.XXXXXX")
  [[ ! -f $USAGE_CACHE ]] || awk -F'|' -v s="$1" '$1 != s' "$USAGE_CACHE" > "$tmp"
  printf '%s|%s|%s\n' "$1" "$2" "$(date +%s)" >> "$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$USAGE_CACHE"
  exec 7>&-
}

cache_line() {    # $1=slot -> cached fields if fresh, else empty
  [[ -f $USAGE_CACHE ]] || return 0
  local line fetched
  line=$(awk -F'|' -v s="$1" '$1 == s' "$USAGE_CACHE" 2>/dev/null | tail -1)
  [[ -n $line ]] || return 0
  fetched=${line##*|}
  [[ $fetched =~ ^[0-9]+$ ]] || return 0
  (( $(date +%s) - fetched < USAGE_TTL )) || return 0
  printf '%s' "$line"
}

# "5h 8% left · 7d 67% left (5h resets 16:39)" from a cache line, or empty.
# The reset time is in the local time zone (set TZ to change it).
render_usage() {  # $1 = cache line
  local IFS='|'; read -r _ p5 r5 p7 _ _ <<< "$1"
  local out=""
  [[ -n ${p5:-} ]] && out="5h $((100 - p5))% left"
  [[ -n ${p7:-} ]] && out="${out:+$out · }7d $((100 - p7))% left"
  [[ -z ${r5:-} ]] || out="$out (5h resets $(fmt_epoch "$r5" '+%H:%M'))"
  printf '%s' "$out"
}

json_str() {      # $1=file  $2=key -> first string value, or empty
  grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$1" 2>/dev/null \
    | head -1 | sed 's/.*:[[:space:]]*"//; s/"$//' || true
}

# The account email of a slot, stored next to it at save time from the profile of
# the last /login. Shown in status and in the switch message only.
email_of() { cat "$DIR/$1.email" 2>/dev/null || true; }

cmd=${1:-}
case "$cmd" in
  -h|--help|help) helptext; exit 0 ;;
  -v|--version|version) echo "claude-account $VERSION"; exit 0 ;;
  usage)
    # Reads every slot, or one with --slot <Name>. --quiet only refreshes the cache.
    want=""; quiet=0
    shift || true
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --slot) [[ -n ${2:-} ]] || { echo "usage: claude-account usage [--slot <Name>] [--quiet]" >&2; exit 1; }
                want=$2; shift 2 ;;
        --quiet) quiet=1; shift ;;
        *) echo "usage: claude-account usage [--slot <Name>] [--quiet]" >&2; exit 1 ;;
      esac
    done
    rc_any=1
    while IFS= read -r s; do
      [[ -n $s ]] || continue
      [[ -n $want && $s != "$want" ]] && continue
      tok=$(token_of "$s")
      if [[ -z $tok ]]; then
        [[ $quiet -eq 1 ]] || echo "slot $s: no token in the slot file"
        continue
      fi
      bodyfile=$(mktemp "$DIR/.body.XXXXXX")
      # || true: under set -e, a curl that cannot reach the network, or a missing
      # fetcher, would otherwise end the whole command with no line printed and
      # nothing in the cache.
      printf '%s\n' "$tok" | fetch_usage > "$bodyfile" 2>/dev/null || true
      fields=$(parse_usage "$bodyfile")
      rm -f "$bodyfile"
      if [[ -z $fields ]]; then
        # A stale access token answers 401 here. That is NOT proof the login is
        # dead: the refresh happens inside a Claude Code session, not in this call.
        if [[ $s == "$(active)" ]]; then
          [[ $quiet -eq 1 ]] || echo "slot $s: no reading (the endpoint refused the live login; check the network, or run claude auth status)"
        else
          [[ $quiet -eq 1 ]] || echo "slot $s: no reading (its saved token is too old; only a session renews one, so usage reads for the active account)"
        fi
        continue
      fi
      cache_put "$s" "$fields"
      rc_any=0
      if [[ $quiet -eq 0 ]]; then
        line="slot $s: $(render_usage "$s|$fields|$(date +%s)")"
        [[ $s == "$(active)" ]] && line+="  [active]"
        echo "$line"
      fi
    done < <(slots)
    exit $rc_any
    ;;
  status|list)
    if [[ ${2:-} == --json ]]; then
      # The same facts as the text below, raw, for programs (the account-picker
      # mod): percents USED and epochs, never rendered text, so a rewording of
      # the human lines cannot break a reader. null where there is no value.
      # held_until: the epoch until which a recent cap or unusable mark holds the
      # slot, null when no mark holds it now.
      num() { if [[ ${1:-} =~ ^[0-9]+$ ]]; then printf '%s' "$1"; else printf null; fi; }
      now=$(date +%s)
      held_until() {  # $1 = cap epoch  $2 = unusable epoch
        local t=0
        if [[ -n $1 ]] && (( $1 + CAP_TTL > now )); then t=$(( $1 + CAP_TTL )); fi
        if [[ -n $2 ]] && (( $2 + UNUSABLE_TTL > now && $2 + UNUSABLE_TTL > t )); then t=$(( $2 + UNUSABLE_TTL )); fi
        if (( t > 0 )); then printf '%s' "$t"; else printf null; fi
      }
      name_or_null() { if valid_name "${1:-}"; then printf '"%s"' "$1"; else printf null; fi; }
      mtime() { if [[ -f $1 ]]; then file_epoch "$1"; fi; }
      cur=$(active); pin=""; [[ -f $PIN_FILE ]] && pin=$(cat "$PIN_FILE")
      printf '{"active":%s,"pinned":%s,"slots":[' "$(name_or_null "$cur")" "$(name_or_null "$pin")"
      sep=""
      # slots() lists only names `switch` accepts, so no name can break the JSON.
      while IFS= read -r s; do
        p5=""; r5=""; p7=""; r7=""
        cl=$(cache_line "$s")
        [[ -z $cl ]] || IFS='|' read -r _ p5 r5 p7 r7 _ <<< "$cl"
        cap=$(mtime "$CAPPED_DIR/$s"); bad=$(mtime "$UNUSABLE_DIR/$s")
        printf '%s{"name":"%s","active":%s,"pinned":%s,"capped_at":%s,"unusable_at":%s,"held_until":%s,"five_hour_used":%s,"five_hour_resets_at":%s,"week_used":%s,"week_resets_at":%s}' \
          "$sep" "$s" "$([[ $s == "$cur" ]] && echo true || echo false)" \
          "$([[ $s == "$pin" ]] && echo true || echo false)" \
          "$(num "$cap")" "$(num "$bad")" "$(held_until "$cap" "$bad")" \
          "$(num "$p5")" "$(num "$r5")" "$(num "$p7")" "$(num "$r7")"
        sep=","
      done < <(slots)
      printf ']}\n'
      exit 0
    fi
    echo "active slot: $(active)"
    if [[ -f $PIN_FILE ]]; then
      echo "pinned: $(cat "$PIN_FILE")  (run 'claude-account unpin' to release)"
    fi
    found=0
    while IFS= read -r s; do
      [[ -n $s ]] || continue
      found=1
      e=$(email_of "$s")
      line="slot $s${e:+ <$e>}: saved $(fmt_epoch "$(file_epoch "$DIR/$s.json")" '+%Y-%m-%d %H:%M')"
      [[ $s == "$(active)" ]] && line+="  [active]"
      [[ -f $PIN_FILE && $s == "$(cat "$PIN_FILE")" ]] && line+="  [pinned]"
      if [[ -f $CAPPED_DIR/$s ]]; then
        mins=$(( ( $(date +%s) - $(file_epoch "$CAPPED_DIR/$s") ) / 60 ))
        line+="  [capped ${mins}m ago]"
      fi
      if [[ -f $UNUSABLE_DIR/$s ]]; then
        mins=$(( ( $(date +%s) - $(file_epoch "$UNUSABLE_DIR/$s") ) / 60 ))
        line+="  [unusable ${mins}m ago]"
      fi
      cl=$(cache_line "$s")
      [[ -n $cl ]] && line+="  $(render_usage "$cl")"
      echo "$line"
    done < <(slots)
    [[ $found -eq 1 ]] || echo "no slots saved yet"
    ;;
  whoami|who)
    # "Did the /login actually switch accounts?" cannot be answered by feel. A login
    # that silently re-auths the SAME account (the browser is already signed in)
    # looks identical to one that switched. This prints what is on disk instead.
    fp() {  # $1=credentials file -> short token fingerprint, or EMPTY
      local t; t=$(json_str "$1" accessToken)
      [[ -n $t ]] || { echo "EMPTY"; return 0; }
      if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$t" | sha256sum | cut -c1-12
      else
        printf '%s' "$t" | shasum -a 256 | cut -c1-12
      fi
    }
    [[ -f $LIVE ]] || { echo "no live login at $LIVE (run /login inside claude first)" >&2; exit 1; }
    livefp=$(fp "$LIVE")
    match=""
    while IFS= read -r s; do
      [[ -n $s ]] || continue
      [[ $(fp "$DIR/$s.json") == "$livefp" ]] && match="$s"
    done < <(slots)
    cur=$(active)
    # The slot is named only when its saved token matches the live one. When none
    # does, the token was refreshed or a new /login put another login here, and
    # nothing on disk tells which, so no slot is guessed. The email below comes from
    # CLAUDE_JSON, which names the account of the LAST /login and does not change on
    # a switch; it is labelled that way and never tied to a slot.
    echo "live login:"
    if [[ -n $match ]]; then
      echo "  slot    : $match"
    else
      echo "  slot    : (no slot matches; token refreshed or a new /login, run save)"
    fi
    if [[ -f $CLAUDE_JSON ]]; then
      echo "  account : $(json_str "$CLAUDE_JSON" emailAddress) (from the last /login)"
      echo "  tier    : $(json_str "$CLAUDE_JSON" organizationRateLimitTier) (from the last /login)"
    else
      echo "  account : (unknown; $CLAUDE_JSON not found)"
    fi
    echo "  token   : $livefp (sha256 prefix, not the token)"
    if [[ $livefp == EMPTY ]]; then
      echo "WARNING: the live accessToken is EMPTY. A failed refresh blanks it; log in again."
    fi
    if [[ -n $match && $match != "$cur" ]]; then
      echo "WARNING: active says '$cur' but the live login is '$match'."
      echo "         'switch' would copy this login over the '$cur' slot. Run: claude-account save $match"
    fi
    # Claude Code prefers an API key over the subscription login, so any of these
    # being set means the login above is NOT what gets billed. It shows up only as
    # odd billing errors, while every check of the subscription looks healthy.
    shadow=""
    for v in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL; do
      [[ -n ${!v:-} ]] && shadow="$shadow $v"
    done
    echo
    if [[ -n $shadow ]]; then
      echo "WARNING: these are set in this shell and OVERRIDE the login above:$shadow"
      echo "         Claude Code will bill that API key, not your subscription."
    else
      echo "no ANTHROPIC_* override in this shell: Claude Code will use the login above."
    fi
    echo
    echo "note: Claude Code 2.x reloads the live login file before each token use, so a"
    echo "      running session follows a switch or a /login before its next request."
    echo "      An older Claude Code keeps the token it started with: restart it"
    echo "      ('claude --resume' keeps the conversation)."
    ;;
  save)
    slot=${2:-}; [[ -n $slot ]] || usage
    valid_name "$slot" || { echo "invalid slot name (letters, digits, - and _ only)" >&2; exit 1; }
    [[ -f $LIVE ]] || { echo "no live credentials at $LIVE (run /login inside claude first)" >&2; exit 1; }
    looks_like_credentials "$LIVE" || { echo "$LIVE does not look like a Claude login (no claudeAiOauth); refusing to save it" >&2; exit 1; }
    take_switch_lock
    put_file "$LIVE" "$DIR/$slot.json"
    e=$(json_str "$CLAUDE_JSON" emailAddress); [[ -z $e ]] || printf '%s\n' "$e" > "$DIR/$slot.email"
    echo "$slot" > "$ACTIVE_FILE"
    echo "saved the live login${e:+ ($e)} as slot $slot (now active)"
    ;;
  switch|use)
    slot=${2:-}; [[ -n $slot ]] || usage
    valid_name "$slot" || { echo "invalid slot name (letters, digits, - and _ only)" >&2; exit 1; }
    from=""
    shift 2
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --from) from=${2:-}; valid_name "$from" || { echo "--from needs a slot name" >&2; exit 1; }; shift 2 ;;
        *) usage ;;
      esac
    done
    [[ -f $DIR/$slot.json ]] || { echo "slot $slot is empty; log in to that account, then: claude-account save $slot" >&2; exit 1; }
    # Never let a non-credentials file become the live login.
    looks_like_credentials "$DIR/$slot.json" || { echo "slot $slot does not contain a Claude login (no claudeAiOauth); refusing to make it live" >&2; exit 1; }
    take_switch_lock
    # --from: switch only if <Name> is still live and nothing is pinned, checked
    # under the lock. A script that read the usage a while ago must not undo a
    # switch or a pin a person made since: the newer choice stands.
    if [[ -n $from ]]; then
      if [[ -f $PIN_FILE ]]; then echo "a slot was pinned after $from was read; no switch" >&2; exit 3; fi
      if [[ $(active) != "$from" ]]; then echo "the live slot is now $(active), not $from; no switch" >&2; exit 3; fi
    fi
    sync_back
    backup_live
    prev=$(active)
    mkdir -p "$(dirname "$LIVE")"
    put_file "$DIR/$slot.json" "$LIVE"
    echo "$slot" > "$ACTIVE_FILE"
    # A pin follows a deliberate switch, so it never points at the old account.
    if [[ -f $PIN_FILE ]]; then echo "$slot" > "$PIN_FILE"; log_switch "switch $prev -> $slot (pin moved)"
    else log_switch "switch $prev -> $slot"; fi
    # Claude Code 2.x checks the live login file's date before each token use and
    # reloads it when the date changed, the same path that lets a /login in one
    # window reach the others. Running sessions follow with no restart.
    # One line, so the account-picker mod can show it as it is.
    e=$(email_of "$slot")
    echo "switched to slot $slot${e:+ ($e)}; running sessions move to $slot before their next request"
    ;;
  pin)
    cur=$(active)
    [[ $cur != unknown ]] || { echo "no active slot to pin; use: claude-account switch <Name>" >&2; exit 1; }
    echo "$cur" > "$PIN_FILE"
    log_switch "pin $cur"
    echo "pinned $cur. release with: claude-account unpin"
    ;;
  unpin)
    if [[ -f $PIN_FILE ]]; then
      log_switch "unpin $(cat "$PIN_FILE")"; rm -f "$PIN_FILE"; echo "unpinned"
    else echo "was not pinned"; fi
    ;;
  history)
    n=${2:-20}; [[ $n =~ ^[0-9]+$ ]] || usage
    if [[ -f $SWITCH_LOG ]]; then tail -n "$n" "$SWITCH_LOG"; else echo "no switches logged yet"; fi
    ;;
  next|swap)
    cur=$(active)
    mapfile -t all < <(slots)
    [[ ${#all[@]} -ge 2 ]] || { echo "next needs 2 or more slots (found ${#all[@]}); use: claude-account switch <Name>" >&2; exit 1; }
    idx=-1
    for i in "${!all[@]}"; do [[ ${all[$i]} == "$cur" ]] && idx=$i; done
    if [[ $idx -lt 0 ]]; then target=${all[0]}; else target=${all[$(( (idx + 1) % ${#all[@]} ))]}; fi
    # Through bash, not $0 alone: a copy that lost its exec bit still runs.
    exec "${BASH:-bash}" "$0" switch "$target"
    ;;
  *) usage ;;
esac
